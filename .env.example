# --- Groq (https://console.groq.com/keys) --- must start with gsk_
GROQ_API_KEY=your_groq_api_key

# --- NextAuth ---
NEXTAUTH_URL=http://localhost:3000
# generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your_random_secret

# --- Google OAuth (https://console.cloud.google.com/apis/credentials) ---
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# --- Supabase Postgres (Project Settings > Database > Connection string) ---
# If your password contains special characters, URL-encode them (e.g. @ becomes %40)
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres"
DIRECT_URL="postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres"
